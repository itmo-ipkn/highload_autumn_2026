# cp .env.example .env
# Логин печатается первой строкой verify
GITHUB_LOGIN=kr1sta1l
GRAFANA_ADMIN_PASSWORD=admin

# --- продюсеры ---
# Событий в секунду на один под-продюсер
EVENTS_PER_SEC=20
# Сколько пользователей ведёт один под (user_id не пересекаются между подами)
USERS_PER_PRODUCER=20
# Доля ядовитых событий
POISON_RATE=0.02
# user_id | none (none нужен для эксперимента 4.3)
KEY_MODE=user_id

# --- консьюмеры ---
PROCESSING_DELAY_MS=20
# earliest: при отсутствии закоммиченного оффсета читаем лог с начала, чтобы не было дыр в seq
AUTO_OFFSET_RESET=earliest
