GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-for-local-development

# Error probability is a fraction from 0 to 1; delays are in milliseconds.
SIMULATION_ERROR_PROBABILITY=0.05
SIMULATION_MIN_DELAY_MS=20
SIMULATION_MAX_DELAY_MS=200

# Total request rate across both application instances.
LOAD_TARGET_RPS=39
LOAD_INCREASE_SECONDS=120
