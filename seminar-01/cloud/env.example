# Copy this file to cloud/env.local on YOUR LAPTOP. Never put an auth token here.
# Read docs/01_from_zero.md before using source: this file is trusted Bash code.
export YC_PROFILE='default'
export YC_CLOUD_ID='REPLACE_WITH_YOUR_CLOUD_ID'
export YC_FOLDER_ID='REPLACE_WITH_YOUR_FOLDER_ID'
export YC_ZONE='ru-central1-a'
export LAB_NAME='s1-yourname-01'
export SSH_CIDR='REPLACE_WITH_YOUR_PUBLIC_IPV4/32'
export SSH_PUBLIC_KEY_FILE="$HOME/.ssh/highload_s1.pub"
export SSH_PRIVATE_KEY_FILE="$HOME/.ssh/highload_s1"
# Local browser ports; change only these if your laptop already uses the defaults.
export LOCAL_GRAFANA_PORT=3000
export LOCAL_PROMETHEUS_PORT=9090
export LOCAL_API_PORT=8080
export LOCAL_ADMIN_PORT=8081
# Set APPROVE_CLOUD_CREATE=YES interactively AFTER reviewing the resource plan.
