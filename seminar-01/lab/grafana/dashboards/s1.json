{
  "id": null,
  "uid": "s1-monitoring",
  "title": "S1 — наблюдение и доказательство",
  "tags": [
    "highload",
    "s1"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "01 | Поток API — entered / finished / 200 / good",
      "description": "1m rate, API handlers only. Completion includes failed responses. No target/offered k6 rate in this panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_requests_started_total{job=\"app\",route=\"/api/work\"}[1m]))",
          "legendFormat": "started_rps",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
          "legendFormat": "completed_rps",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\",status=\"200\"}[1m]))",
          "legendFormat": "success_rps",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\",le=\"0.3\"}[1m]))",
          "legendFormat": "good_rps",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "02 | Ошибки 5xx / все завершившиеся",
      "description": "No traffic => undefined / No data, not 0%. 499 cancellation is separate from 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\",status=~\"5..\"}[1m])) / sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
          "legendFormat": "errors",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "03 | Успешные ответы: среднее, p50, p95, p99",
      "description": "Server-side HTTP 200 only, 1m window. Classic histogram interpolation. Not exact raw quantiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_request_duration_seconds_sum{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])) / sum(rate(lab_request_duration_seconds_count{job=\"app\",route=\"/api/work\",status=\"200\"}[1m]))",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "04 | Хорошие события: HTTP 200 И ≤300 мс",
      "description": "Server diagnostic SLI over 1m. Product target used in exercise: ≥99% over 28d. Do not claim 28d SLO from this chart.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\",le=\"0.3\"}[1m])) / sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
          "legendFormat": "good",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "05 | Конкурентность и ограниченный ресурс",
      "description": "active + waiting approximates inflight at scrape instants. Capacity=8 simulated I/O slots, not CPU cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lab_inflight{job=\"app\"})",
          "legendFormat": "inflight",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(lab_pool_active{job=\"app\"})",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "C",
          "expr": "sum(lab_pool_waiting{job=\"app\"})",
          "legendFormat": "waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "D",
          "expr": "sum(lab_pool_capacity{job=\"app\"})",
          "legendFormat": "capacity",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "06 | Где потеряно время?",
      "description": "p95 ожидания только для outcome=acquired; timeout — отдельные события. Среднее удержания слота — для выполненной внутри пула работы.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_pool_wait_seconds_bucket{job=\"app\",outcome=\"acquired\"}[1m])))",
          "legendFormat": "queue_p95",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_service_seconds_sum{job=\"app\"}[1m])) / sum(rate(lab_service_seconds_count{job=\"app\"}[1m]))",
          "legendFormat": "service_mean",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "07 | CPU ПРОЦЕССА приложения, ядра",
      "description": "1.0 = one fully occupied logical CPU. Not percent of VM. Single Python process, 1 CPU Compose quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_cpu_seconds_total{job=\"app\"}[1m]))",
          "legendFormat": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "08 | RSS ПРОЦЕССА приложения",
      "description": "Resident process memory, not Docker memory limit and not full VM memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{job=\"app\"})",
          "legendFormat": "rss",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "09 | Доступность /metrics",
      "description": "up=1 means scrape succeeded. It does not mean business API works.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"app\"}",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "10 | Режим эксперимента",
      "description": "One-hot mode labels are bounded. Known experimental condition. Each student records a prediction before changing mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_mode{job=\"app\"}",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "11 | CPU ВМ — только Linux host profile",
      "description": "Whole VM average, not app CPU. Docker Desktop host view is Linux VM / may be unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[1m])))",
          "legendFormat": "host_cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "12 | Память ВМ — только Linux host profile",
      "description": "1 - MemAvailable/MemTotal; not 1 - MemFree/MemTotal.",
      "datasource": {
        "type": "prometheus",
        "uid": "s1-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "legendFormat": "host_ram",
          "datasource": {
            "type": "prometheus",
            "uid": "s1-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
