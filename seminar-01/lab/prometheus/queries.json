{
  "started_rps": "sum(rate(lab_requests_started_total{job=\"app\",route=\"/api/work\"}[1m]))",
  "completed_rps": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
  "success_rps": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\",status=\"200\"}[1m]))",
  "errors": "sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\",status=~\"5..\"}[1m])) / sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
  "mean": "sum(rate(lab_request_duration_seconds_sum{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])) / sum(rate(lab_request_duration_seconds_count{job=\"app\",route=\"/api/work\",status=\"200\"}[1m]))",
  "p50": "histogram_quantile(0.50, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
  "p95": "histogram_quantile(0.95, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
  "p99": "histogram_quantile(0.99, sum by (le) (rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\"}[1m])))",
  "good": "sum(rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\",le=\"0.3\"}[1m])) / sum(rate(lab_requests_total{job=\"app\",route=\"/api/work\"}[1m]))",
  "good_rps": "sum(rate(lab_request_duration_seconds_bucket{job=\"app\",route=\"/api/work\",status=\"200\",le=\"0.3\"}[1m]))",
  "up": "up{job=\"app\"}",
  "inflight": "sum(lab_inflight{job=\"app\"})",
  "active": "sum(lab_pool_active{job=\"app\"})",
  "waiting": "sum(lab_pool_waiting{job=\"app\"})",
  "capacity": "sum(lab_pool_capacity{job=\"app\"})",
  "queue_p95": "histogram_quantile(0.95, sum by (le) (rate(lab_pool_wait_seconds_bucket{job=\"app\",outcome=\"acquired\"}[1m])))",
  "service_mean": "sum(rate(lab_service_seconds_sum{job=\"app\"}[1m])) / sum(rate(lab_service_seconds_count{job=\"app\"}[1m]))",
  "cpu": "sum(rate(process_cpu_seconds_total{job=\"app\"}[1m]))",
  "rss": "sum(process_resident_memory_bytes{job=\"app\"})",
  "host_cpu": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[1m])))",
  "host_ram": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
  "host_busy_core": "100 * (1 - rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[1m]))",
  "mode": "lab_mode{job=\"app\"}",
  "resets": "sum(resets(lab_requests_total{job=\"app\",route=\"/api/work\"}[5m]))"
}