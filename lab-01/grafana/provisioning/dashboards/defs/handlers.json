{
  "title": "CRUD vault -- metrics per handler (Multi-App)",
  "uid": "handlers",
  "timezone": "utc",
  "schemaVersion": 40,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "datacenter",
        "label": "DATACENTER",
        "query": "label_values(datacenter)",
        "regex": "",
        "datasource": {
          "type": "prometheus",
          "uid": "crud-vault-prometheus"
        },
        "includeAll": true,
        "includeAllValue": ".*|$",
        "multi": true,
        "options": [],
        "current": {
          "tags": [],
          "text": "All",
          "value": "$__all"
        },
        "sort": 0,
        "hide": 0
      },
      {
        "type": "query",
        "name": "pod",
        "label": "POD_ID",
        "query": "label_values(pod)",
        "regex": "",
        "datasource": {
          "type": "prometheus",
          "uid": "crud-vault-prometheus"
        },
        "includeAll": true,
        "includeAllValue": ".*|$",
        "multi": true,
        "options": [],
        "current": {
          "tags": [],
          "text": "All",
          "value": "$__all"
        },
        "sort": 0,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "POST /items Latency (ms)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "crud-vault-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",route=\"/items\",datacenter=~\"$datacenter\",pod=~\"$pod\"}[1m])) by (le)) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "crud-vault-prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",route=\"/items\",datacenter=~\"$datacenter\",pod=~\"$pod\"}[1m])) by (le)) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "crud-vault-prometheus"
          },
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{method=\"POST\",route=\"/items\",datacenter=~\"$datacenter\",pod=~\"$pod\"}[1m])) by (le)) * 1000",
          "datasource": {
            "type": "prometheus",
            "uid": "crud-vault-prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none"
            },
            "axisPlacement": "auto",
            "axisLabel": "latency (ms)",
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
