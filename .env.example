# Kafka producer settings
KAFKA_BOOTSTRAP=kafka-1:19092,kafka-2:19092,kafka-3:19092
POD_COUNT=3
POOL_SIZE=60
EVENT_RATE_PER_SEC=15
KEY_MODE=user_id
POISON_PERCENT=2

# Kafka consumer settings
GROUP_ID=events-processor
PROCESSING_DELAY_MS=50

# Grafana admin credentials (generated by scripts/configure.py)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=GENERATE_LOCALLY

# Postgres admin credentials (generated by scripts/configure.py)
PGUSER=events
PGPASSWORD=GENERATE_LOCALLY

# GitHub login printed by verify
GITHUB_LOGIN=MickeyRU