
APP1_PORT=18081
APP2_PORT=18082


ENABLE_DEMO_FAULTS=1
DEMO_DELAY_MS=5


PROMETHEUS_PORT=9090

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Empty: generate once at startup and reuse the password from the local volume.
# For an existing Grafana database, set its current password on first migration.
GRAFANA_ADMIN_PASSWORD=


LOAD_RPS=30
LOAD_RAMP_SECONDS=120
LOAD_ERROR_PERCENT=4
LOAD_WORKERS=16
