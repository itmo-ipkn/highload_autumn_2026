# Переменные docker compose. Скопируйте в .env (`make env`) и при необходимости поправьте.
# У всех значений есть дефолты в docker-compose.yaml, так что без .env проект тоже запустится.

# --- Kafka ---
KAFKA_IMAGE=apache/kafka:4.3.2
# Общий для трёх узлов идентификатор KRaft-кластера (base64 UUID, 22 символа).
KAFKA_CLUSTER_ID=58NdqhVpSvG7NO52JRe5lw
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# Адрес, который брокеры сообщают клиентам с хоста (listener EXTERNAL, порты 9091-9093).
#   localhost            — CLI запускается на самом хосте;
#   host.docker.internal — CLI запускается внутри devcontainer (Docker Desktop).
KAFKA_EXTERNAL_HOST=localhost
# Интерфейс хоста, на котором публикуются порты.
KAFKA_BIND_ADDR=127.0.0.1

EVENTS_TOPIC=events
DLT_TOPIC=events.dlt

# --- Postgres (sink) ---
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5432
