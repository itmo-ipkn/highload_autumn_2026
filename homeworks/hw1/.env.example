# Optional bootstrap input for stack-init. An empty password is not a password:
# the initializer generates one on first start and stores it in the credentials volume.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Pinned images used by Docker Compose.
GOLANG_IMAGE=golang:1.26.8-alpine3.24
ALPINE_IMAGE=alpine:3.24.3
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.3.0
# Do not upgrade without checking externally-controlled duration: "0s" support.
K6_IMAGE=grafana/k6:1.6.0
