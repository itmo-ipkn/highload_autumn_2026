# cp .env.example .env — при желании поменяйте пароль. Файл .env в git не попадает.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# Вероятность искусственной 500-ки на бизнес-ручках
FAIL_RATE=0.03
# Средняя искусственная задержка бизнес-ручек, мс (экспоненциальное распределение; 0 — выключено)
DELAY_MEAN_MS=20
# Нагрузка: целевой суммарный RPS после разгона, длительность разгона и доля 404
TARGET_RPS=40
RAMP_SECONDS=180
NOT_FOUND_RATE=0.05
