    {
      "id": 18,
      "type": "stat",
      "title": "Ordering violations (known order)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "rawSql": "SELECT count(*)::bigint AS value FROM (SELECT seq, lag(seq) OVER (PARTITION BY user_id ORDER BY processing_order) AS prev_seq FROM processed_events WHERE processing_order IS NOT NULL) ordered WHERE seq < prev_seq",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
