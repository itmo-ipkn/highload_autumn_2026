        "query": "label_values(http_handler_requests_total, datacenter)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "type": "query",
        "name": "pod",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "prom-main" },
        "query": "label_values(http_handler_requests_total{datacenter=~\"$datacenter\"}, pod_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
