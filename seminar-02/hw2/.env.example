# Copy to .env before `docker compose up` (cp .env.example .env).
# DEMO sample values, not real secrets; .env itself is gitignored.
GITHUB_LOGIN=github_login

# Postgres sink. Demo credentials for a local compose stand only.
POSTGRES_USER=lab2
POSTGRES_DB=lab2
POSTGRES_PASSWORD=lab2-demo-password

# Grafana (same convention as HW1). Fixed local development password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# Runtime settings.
USERS_PER_POD=10
EVENTS_PER_SECOND=10
POISON_RATE=0.02
POISON_MODE=flag            # flag | corrupt
KEY_MODE=user_id            # user_id | none
RUN_DURATION=0                  # seconds each producer generates; 0 = run until stopped
PROCESSING_DELAY_MS=20
MAX_POLL_RECORDS=50
MAX_ATTEMPTS=3
IDLE_EXIT_SECONDS=0             # 0 = never exit on idle; otherwise exits after this many empty polls
PERSIST_EVERY=100           # producer persists per-user counters every N events
KAFKA_VERSION=4.1.0
