# Пример env-переменных. Скопируйте: cp .env.example .env
# .env не коммитится (см. .gitignore).

# --- Экземпляры приложения (пробрасываются в контейнеры как POD_ID / DATACENTER) ---
POD_ID_1=pod-1
DATACENTER_1=dc-1
POD_ID_2=pod-2
DATACENTER_2=dc-2

# --- Порты на хосте ---
APP1_PORT=8081
APP2_PORT=8082
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Grafana ---
# Пароль обязателен: без него `docker compose up` упадёт с ошибкой.
# Минимальная длина пароля Grafana — 5 символов.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
# uid datasource из grafana/provisioning/datasources/prometheus.yml;
# на него ссылается генератор дашборда (не меняйте синхронно с provisioning-файлом)
GRAFANA_DATASOURCE_UID=prometheus-ddia

# --- Часть 3: параметры нагрузочного инструмента (заготовки) ---
TARGET_RPS=40
ERROR_RATE=0.05
