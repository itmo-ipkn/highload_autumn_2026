# Application instances
APP1_POD_ID=pod-1
APP1_DATACENTER=dc-1
APP2_POD_ID=pod-2
APP2_DATACENTER=dc-2

# Artificial failure rate for business handlers (0..1).
# Инъекция сбоя в бизнес-ручках; /health, /metrics, /handlers всегда 200.
FAILURE_RATE=0.03

# Cap in-memory store (LRU eviction above the cap)
MAX_ITEMS=10000

# Host ports (published on 127.0.0.1 only)
APP1_PORT=8000
APP2_PORT=8001
PROM_PORT=9090
GRAFANA_PORT=3000

# k6 load hold (L2a). Формат k6-длительности: 90s, 2m, 12h.
# Демо-прогон: K6_HOLD=2m; полный — оставить 12h.
K6_HOLD=12h

# Grafana admin credentials (placeholders only; never commit real values)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
